# 复制为 .env.production，填上真实值。绝不要提交到 git。

# ───── Flask 基础 ─────
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=请用 openssl rand -hex 32 生成
SESSION_COOKIE_SECURE=true
TRUSTED_PROXY_HOPS=1
PORT=5001

# ───── 业务开关：上线前必须切换 ─────
FREE_TRIAL_MODE=false
PAYMENT_MODE=wechatpay
IMAGE_GENERATION_PROVIDER=doubao
DOUBAO_ALLOW_MOCK_FALLBACK=false

# ───── 豆包 / 火山方舟 ─────
DOUBAO_API_KEY=ark_xxxxxxxxxxxxxxxxxxxx
DOUBAO_MODEL=
DOUBAO_IMAGE_SIZE=2K
DOUBAO_FULL_BODY_IMAGE_SIZE=2K
DOUBAO_RESPONSE_FORMAT=url
DOUBAO_TIMEOUT_SECONDS=180
# 用对象存储（OSS/R2）时改为 url；本机调试用 data_url
DOUBAO_INPUT_IMAGE_FORMAT=url
DOUBAO_PUBLIC_BASE_URL=https://cdn.your.domain

# ───── 微信支付 Native ─────
WECHATPAY_MCH_ID=1900000xxx
WECHATPAY_SERIAL_NO=证书序列号40位
WECHATPAY_API_V3_KEY=APIv3密钥32位
WECHATPAY_APPID=wx开头的公众号或开放平台APPID
WECHATPAY_NOTIFY_URL=https://your.domain/api/payments/wechat/notify
WECHATPAY_PRIVATE_KEY_PATH=/app/wechatpay_certs/apiclient_key.pem
WECHATPAY_CERT_DIR=/app/wechatpay_certs

# ───── Sentry 监控（可选但强烈推荐） ─────
SENTRY_DSN=

# ───── 阿里云 OSS（外置对象存储，可选 P1） ─────
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://cdn.your.domain

# ───── Redis（限流/会话/缓存） ─────
REDIS_URL=redis://redis:6379/0
