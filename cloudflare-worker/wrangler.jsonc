{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "impeccable-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-19",
  "assets": {
    "directory": "./形象照",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Auralis 曜临",
    "PUBLIC_SITE_NAME": "Auralis 曜临",
    "SESSION_COOKIE_NAME": "impeccable_session",
    "INITIAL_CREDITS": "300",
    "GENERATION_COST_CREDITS": "100",
    "FREE_TRIAL_MODE": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "impeccable-db",
      "database_id": "a5f8f0c0-eb1d-4198-8f68-3c75a36c003d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "impeccable-uploads"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
